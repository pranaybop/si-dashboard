# Copy to /etc/finra-ingest.env and chmod 600. Do not commit the real file.
# Use the Supabase session-pooler URI (port 5432, IPv4). Direct connections
# often require IPv6, which a small VPS and Cloud Run do not have.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional. Fine-grained PAT with Contents: Read and write on the repo that
# publishes GitHub Pages. Classic PAT alternative: repo scope.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=zyyzx/si-dashboard

# Optional dead-man's switch (https://healthchecks.io). Pinged by refresh-cycle.
# Create a check with schedule "17 6 * * 1-5", timezone America/Chicago, grace 2 hours.
FINRA_HEALTHCHECK_URL=
