# Copy to scheduler/airflow/.env. That file is gitignored.
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Local Airflow metadata encryption only. Fill this in before `docker compose up`:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=replace-with-a-long-random-string

# Session-pooler URI. Never commit the real value.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional Pages publish after a fresh ingest.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=zyyzx/si-dashboard
