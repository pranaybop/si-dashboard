# Large data files (not needed for GitHub Pages)
*.csv
*.bin
*.parquet

# CapIQ Excel templates (contain formulas, not data)
capiq_float_historical.xlsx
capiq_float_template.xlsx

# Snapshots (historical backups)
snapshots/

# IBKR borrow poller working folder. borrow.db is ~285 MB — well over
# GitHub's 100 MB file limit — and is the system of record for observations
# that cannot be re-collected. It is read read-only by analytics/borrow.py
# and must never be committed.
borrow-data/

# Pipeline build artifacts (not needed in repo)
exports/
analytics/*.parquet

# Python cache
__pycache__/
*.pyc

# Local backups
si_dashboard.html.bak*

# Claude project local config (machine-local: scheduled task locks, permission settings)
.claude/

# Supabase-generated Pages deployment output
site/
